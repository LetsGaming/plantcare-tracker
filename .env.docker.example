# Copy to `.env` next to docker-compose.yml. `.env` is gitignored; never commit it.

# Required. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional: token lifetimes
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Optional: powers the AI care guides; without it the guide stream ends with an error event
OPENAI_API_KEY=

# Optional: plant recognition model baked into the image; set to a different path to swap it
RECOGNITION_MODEL_PATH=/app/models/dinov2-small-q8.onnx

# Port the app is published on (the frontend container)
HTTP_PORT=8080

# Only needed when the browser reaches the API on another origin than the app.
# With the bundled nginx everything is same-origin and both can stay empty.
ALLOWED_ORIGINS=
# Public origin used in image URLs behind a proxy that rewrites the Host header, e.g. https://plants.example.com
PUBLIC_BASE_URL=

# Build-time API location of the frontend; the default is relative to the nginx that serves it
VITE_API_URL=/api/v2
