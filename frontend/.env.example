# Settings of the frontend. The first `pnpm run dev` or `pnpm run build` copies this file to `.env`
# (gitignored) and later adds new settings to it automatically. Values you set are never changed.

# Full address of the API, for example http://plants.lan.net/api/v2.
# Empty uses the default: the same host on port 5000 in development, /api/v2 on the same origin in a
# production build (the Docker image and a reverse proxy in front of both).
VITE_API_URL=

# Name shown in the browser tab
VITE_APP_TITLE=Plantcare Tracker

# Hours until cached data is fetched again. Empty uses 6 in development and 24 in production.
VITE_CACHE_EXPIRE_HOURS=
