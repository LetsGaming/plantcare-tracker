    "bump-version:major": "node scripts/bump-version.js major"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "^8.1.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/status-bar": "^8.0.1",
    "@ionic/storage": "^4.0.0",
    "@ionic/vue": "^8.7.17",
    "@ionic/vue-router": "^8.7.17",
    "chart.js": "^4.5.1",
    "ionicons": "^8.0.13",
    "luxon": "^3.7.2",
    "vue": "^3.5.28",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@types/luxon": "^3.7.1",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "cypress": "^15.10.0",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.7.0",
    "jsdom": "^28.0.0",
    "terser": "^5.46.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  },
  "overrides": {
    "tar": "^7.5.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "vue-router": "5"
      }
