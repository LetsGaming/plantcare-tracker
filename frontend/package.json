{
  "name": "plantcare-frontend",
  "private": true,
  "version": "3.2.0",
  "type": "module",
  "description": "Frontend for Plant Care Tracker Webapp",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "check-keys": "node scripts/locals_key_diff.js",
    "bump-version:patch": "node scripts/bump-version.js patch",
    "bump-version:minor": "node scripts/bump-version.js minor",
    "bump-version:major": "node scripts/bump-version.js major"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/status-bar": "^8.0.2",
    "@ionic/storage": "^4.0.0",
    "@ionic/vue": "^8.8.9",
    "@ionic/vue-router": "^8.8.9",
    "chart.js": "^4.5.1",
    "ionicons": "^8.0.13",
    "luxon": "^3.7.2",
    "vue": "^3.5.35",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@types/luxon": "^3.7.1",
    "@vitejs/plugin-legacy": "^8.0.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/test-utils": "^2.4.11",
    "cypress": "^15.17.0",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "terser": "^5.48.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.4"
  },
  "overrides": {
    "tar": "^7.5.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "vue-router": "5"
      }
    },
    "overrides": {
      "qs@>=6.7.0 <=6.14.1": ">=6.14.2",
      "tar@<7.5.8": ">=7.5.8",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
      "minimatch@>=10.0.0 <10.2.1": ">=10.2.1",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3",
      "tar@<=7.5.9": ">=7.5.10",
      "tar@<=7.5.10": ">=7.5.11",
      "flatted@<3.4.0": ">=3.4.0"
    }
