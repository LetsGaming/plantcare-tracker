{
  "name": "plantcare-frontend",
  "private": true,
  "version": "3.2.0",
  "packageManager": "pnpm@10.34.4",
  "type": "module",
  "description": "Frontend for Plant Care Tracker Webapp",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "check-keys": "node scripts/locals_key_diff.js",
    "bump-version:patch": "node scripts/bump-version.js patch",
    "bump-version:minor": "node scripts/bump-version.js minor",
    "bump-version:major": "node scripts/bump-version.js major",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/status-bar": "^8.0.2",
    "@ionic/storage": "^4.0.0",
    "@ionic/vue": "^8.8.19",
    "@ionic/vue-router": "^8.8.19",
    "chart.js": "^4.5.1",
    "ionicons": "^8.0.13",
    "luxon": "^3.7.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@pinia/testing": "^2.0.1",
    "@types/luxon": "^3.7.1",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/test-utils": "^2.5.1",
    "cypress": "^15.21.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.12"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "vue-router": "5"
      }
    },
    "overrides": {
      "qs@>=6.7.0 <=6.14.1": ">=6.14.2",
      "tar@<7.5.8": ">=7.5.8",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
      "minimatch@>=10.0.0 <10.2.1": ">=10.2.1",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3",
      "tar@<=7.5.9": ">=7.5.10",
      "tar@<=7.5.10": ">=7.5.11",
      "flatted@<3.4.0": ">=3.4.0",
      "brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12",
      "undici@>=7.0.0 <7.29.1": "^7.29.1",
      "tar@<=7.5.20": ">=7.5.21",
      "qs@>=6.14.2 <=6.15.3": ">=6.16.0",
      "@xmldom/xmldom@<=0.9.11": ">=0.9.12",
      "source-map-js@<1.2.2": ">=1.2.2",
      "postcss-selector-parser@<7.1.6": ">=7.1.6"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
