    "bump-version:major": "node scripts/bump-version.js major"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "^8.2.0",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/keyboard": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@ionic/storage": "^4.0.0",
    "@ionic/vue": "^8.8.1",
    "@ionic/vue-router": "^8.8.1",
    "chart.js": "^4.5.1",
    "ionicons": "^8.0.13",
    "luxon": "^3.7.2",
    "vue": "^3.5.30",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "@types/luxon": "^3.7.1",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "cypress": "^15.12.0",
    "eslint": "^10.0.3",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^29.0.0",
    "terser": "^5.46.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.6"
  },
  "overrides": {
    "tar": "^7.5.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "vue-router": "5"
      }
    }
