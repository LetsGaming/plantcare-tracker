# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. Never commit real secrets.

# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins (localhost is always allowed in development)
ALLOWED_ORIGINS=

# Database (default: ./data/plantcare.db)
DB_PATH=

# Image uploads (default: ./uploads)
NAS_PATH=

# JWT configuration: use long, random strings in production
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# OpenAI API key (powers the AI care guides on /api/v2/more-info)
OPENAI_API_KEY=sk-your-key-here
