# Settings of the backend. `pnpm run dev` and `pnpm start` copy this file to `.env` (gitignored) when it
# is missing and add new settings to it after updates. Values you set are never changed, and the two
# JWT secrets are generated for you. Never commit `.env`.

# Server
PORT=5000
# Comma-separated list of allowed browser origins (localhost is always allowed in development)
ALLOWED_ORIGINS=

# Database (default: ./data/plantcare.db)
DB_PATH=

# Image uploads (default: ./uploads)
NAS_PATH=

# Public origin used in image URLs, e.g. https://api.example.com (default: the request's origin)
PUBLIC_BASE_URL=

# JWT configuration: random strings, generated automatically when empty
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# OpenAI API key (powers the AI care guides on /api/v2/more-info)
OPENAI_API_KEY=

# Path to the plant recognition ONNX model (empty = recognition disabled; pnpm run model:fetch downloads it to ./models)
RECOGNITION_MODEL_PATH=

# Reverse proxies in front of the server whose X-Forwarded-For is trusted (default 1, 0 = none).
# Must equal the real proxy count: a higher value lets clients spoof their IP past the rate limiters.
TRUST_PROXY_HOPS=

# Logging: true writes to stdout only, without rotating files in ./logs (default false)
LOG_TO_STDOUT=

# Sales refresher: scrapes the shops in the background and stores the results
# Scrape in the background (default true; false = no background scraping, only the admin recheck scrapes)
SALES_REFRESH_ENABLED=
# Minutes between refreshes of one source, 1 to 10080 (default 120)
SALES_REFRESH_INTERVAL_MIN=
# Milliseconds after listen before stale sources are refreshed, 0 to 600000 (default 5000)
SALES_REFRESH_WARM_DELAY_MS=
# Days an inactive sale is kept before it is pruned, 1 to 3650 (default 30)
SALES_RETENTION_DAYS=
# Price points kept per sale, 1 to 1000 (default 30)
SALES_PRICE_POINTS_MAX=

# Images
# Generate missing 160 and 480 px variants in the background after the server listens (default false;
# pnpm run images:backfill does the same from the command line)
IMAGE_BACKFILL_ON_START=
# Decoder pixel limit for uploads, width x height (default 40000000)
UPLOAD_MAX_PIXELS=
